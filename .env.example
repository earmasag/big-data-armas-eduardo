# Configuración de MongoDB para el Proyecto Final de Big Data
MONGO_INITDB_ROOT_USERNAME=changeme
MONGO_INITDB_ROOT_PASSWORD=changeme
MONGO_HOST=mongodb
MONGO_PORT=27017
MONGO_DB=orinoco_bigdata
MONGO_COLLECTION=analisis_crispdm

# URI de conexión dentro de la red de Docker Compose
MONGO_URI=mongodb://changeme:changeme@mongodb:27017/?authSource=admin

# Puertos expuestos al host
STREAMLIT_PORT=8501
JUPYTER_PORT=8888
